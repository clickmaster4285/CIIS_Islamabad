# Virtual environments (never commit)
venv/
.venv/
env/
paddle_venv/

# Python
__pycache__/
*.py[cod]
*.log
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets
.env
.env.*
!.env.example

# Training / runtime artifacts
runs/
output/
*.pt
*.pth
*.onnx
*.engine
*.pkl

# Keep small config under models if needed; ignore weight files
models/**/*.onnx
models/**/*.pt
models/**/*.pth

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Motion clips waiting for the backend to collect them
motion_clips/

# Runtime state written by the live service (per node) — never commit
data/identity_counters*.json
data/identity_counters*.json.corrupt-*
data/.identity_counters*.tmp
data/*.tmp
# Face embedding cache (biometric data)
data/face_embeddings_cache.json
